# Editor settings for every file of the repository.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

# Two spaces at the end of a line are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
